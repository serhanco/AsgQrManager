Options -Indexes
RewriteEngine On
# RewriteBase / (Alt klasörlerde otomatik/bağıl çalışması için iptal edildi)

# ─── Güvenlik: hassas dosyalara erişimi engelle ───────────────────────────────
<FilesMatch "^(config|schema)\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# install.php güvenliği, PHP içerisindeki installed.lock kontrolü ile sağlanır.

# ─── Yönlendirme kuralları ────────────────────────────────────────────────────
# Var olan dosya/klasöre dokunma
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# /r/{slug} → r.php
RewriteRule ^r/([A-Za-z0-9_-]+)/?$ r.php?c=$1 [L,QSA]

# admin/ altındaki clean URL'ler (gelecekte ihtiyaç olursa)
# RewriteRule ^admin/(.+)$ admin/$1 [L]

# Kök isteği → index.php
RewriteRule ^$ index.php [L]

# ─── HTTP Güvenlik Başlıkları ─────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── PHP hata gösterimini kapat (log dosyasına yazılacak) ─────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
